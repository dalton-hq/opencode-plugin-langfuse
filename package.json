{
  "name": "opencode-plugin-langfuse",
  "version": "0.3.0",
  "description": "Langfuse observability plugin for OpenCode - LLM tracing, prompt versioning, and cost tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "prepare": "tsc || true"
  },
  "keywords": [
    "opencode",
    "langfuse",
    "observability",
    "llm",
    "tracing",
    "ai"
  ],
  "author": "omercnet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/opencode-plugin-langfuse.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@langfuse/otel": "6.1.1",
    "@opencode-ai/plugin": "1.19.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/sdk-node": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
